{
  "defaultBaseRef": "origin/workflow/shared-context",
  "sourceExtensions": [".py", ".R", ".ps1", ".sh", ".js", ".ts"],
  "sourceRoots": ["R", "scripts", "shiny", "analysis", "data-raw", "governance"],
  "includeRootFiles": true,
  "excludedPathPrefixes": [
    ".git/",
    ".agents/",
    ".claude/",
    ".codex/",
    "archive/",
    "cache/",
    "data/",
    "docs/technical_methodology/",
    "old/",
    "results/",
    "shiny/renv/",
    "worktrees/"
  ],
  "testFilePatterns": [
    "^tests/testthat/test-.*\\.R$",
    "^tests/test_.*\\.py$",
    "^tests/test-.*\\.(js|ts)$",
    "^tests/.*\\.(test|spec)\\.(js|ts)$",
    "^governance/tests/Test-.*\\.ps1$"
  ],
  "waiverPathPrefix": "governance/test-waivers/",
  "maxWaiverDays": 30,
  "warningLines": 500,
  "maximumLines": 1000
}
